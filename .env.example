# =============================================================================
# .env.example — copy to .env.{tenant-slug} for each tenant container
# Example: .env.resto-demo, .env.clinic-demo, .env.telecom-demo
# Never commit real credentials. Fill every value before starting the container.
# =============================================================================

# ── Tenant identity ────────────────────────────────────────────────────────────
# UUID of this tenant in the clients table. Unique per container.
TENANT_ID=

# ── Admin portal credentials ───────────────────────────────────────────────────
# Used by src/routes/auth.js to authenticate the super-admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://yayah:PASSWORD@yayah-postgres/yayah
# Set to "true" only when connecting to a remote managed DB (RDS, Neon, etc.)
# Leave unset or "false" for local Docker network connections.
DATABASE_SSL=false

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://yayah-redis:6379
# Unique prefix for all Redis keys this container writes.
# Use the tenant slug: resto-demo, clinic-demo, telecom-demo, etc.
REDIS_PREFIX=

# ── WhatsApp ───────────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── AI ─────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional — override the default embedding model
# EMBEDDING_MODEL=gemini-embedding-001

# ── Knowledge base (Pinecone) ──────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Namespace isolates this tenant's vectors inside the shared Pinecone index.
PINECONE_NAMESPACE=

# ── Knowledge base — Confluence (server-level fallback) ───────────────────────
# Per-client values are stored encrypted in the DB.
# These env vars are used only when the client record has no Confluence config.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# ── Knowledge base — Google Sheets ────────────────────────────────────────────
GOOGLE_SHEET_ID=
SHEETS_WEBHOOK_TOKEN=

# ── Knowledge base — Microsoft / Azure ────────────────────────────────────────
# Per-client values are stored encrypted in the DB.
# These env vars are used only when the client record has no Microsoft config.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_USER_EMAIL=
MICROSOFT_DRIVE_ID=
MICROSOFT_ITEM_ID=

# ── Payments (Flutterwave) ─────────────────────────────────────────────────────
# Per-client keys are stored encrypted in the DB.
# These env vars are used as server-level fallbacks.
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_PAYMENT_REDIRECT_URL=
# Default deposit amount (used when client record has no depositAmount set)
DEPOSIT_AMOUNT=

# ── Google OAuth (for employee calendar integration) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Email of the default employee used for calendar lookups
EMPLOYEE_EMAIL=

# ── Zoho CRM (global — admin only) ────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_REFRESH_TOKEN=

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_BASE_URL=
ENCRYPTION_KEY=
JWT_SECRET=
# Optional — set to "warn" or "error" to reduce log verbosity in production
LOG_LEVEL=info
# Set to "false" to disable RAG (AI will answer without knowledge base)
USE_RAG=true
